{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "node scripts/vercel-build.mjs",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": {
      "codex/release-landing-reader-vercel": true
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
